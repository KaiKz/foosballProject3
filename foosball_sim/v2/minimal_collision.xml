<mujoco>
  <option gravity="0 0 -9.81"/>

  <worldbody>
    <!-- Flat ground -->
    <body name="ground" pos="0 0 0">
      <geom type="plane" size="1 1 0.01" rgba="0.9 0.9 0.9 1"
            contype="0" conaffinity="0"/>
    </body>

    <!-- Free ball falling onto a box -->
    <body name="ball_body" pos="0 0 0.5">
      <joint name="ball_free" type="free"/>
      <geom name="ball" type="sphere" size="0.05" density="1000"
            contype="1" conaffinity="1" rgba="1 0 0 1"/>
    </body>

    <body name="block" pos="0 0 0.1">
      <geom name="block_geom" type="box" size="0.1 0.1 0.1"
            contype="1" conaffinity="1" rgba="0 0 1 1"/>
    </body>
  </worldbody>
</mujoco>
