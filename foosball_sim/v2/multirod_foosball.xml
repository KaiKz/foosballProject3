<mujoco model="multirod_foosball">
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <worldbody>
    <!-- Ground plane -->
    <body name="ground" pos="0 0 0">
      <geom name="ground" type="plane"
            size="2 2 0.1"
            contype="1" conaffinity="1"
            rgba="0.8 0.9 0.8 1"/>
    </body>

    <!-- Ball -->
    <body name="ball_body" pos="0 0 0.10">
      <joint name="ball_free" type="free"/>
      <geom name="ball" type="sphere" size="0.02"
            density="1000"
            contype="1" conaffinity="1"
            rgba="1 0 0 1"/>
    </body>

    <!-- Simple field walls -->
    <body name="wall_top" pos="0 0.35 0.05">
      <geom name="wall_top_geom" type="box"
            size="0.40 0.02 0.05"
            contype="1" conaffinity="1"
            rgba="0.2 0.2 0.8 1"/>
    </body>
    <body name="wall_bottom" pos="0 -0.35 0.05">
      <geom name="wall_bottom_geom" type="box"
            size="0.40 0.02 0.05"
            contype="1" conaffinity="1"
            rgba="0.2 0.2 0.8 1"/>
    </body>
    <body name="wall_left" pos="-0.45 0 0.05">
      <geom name="wall_left_geom" type="box"
            size="0.02 0.35 0.05"
            contype="1" conaffinity="1"
            rgba="0.2 0.2 0.8 1"/>
    </body>
    <body name="wall_right" pos="0.45 0 0.05">
      <geom name="wall_right_geom" type="box"
            size="0.02 0.35 0.05"
            contype="1" conaffinity="1"
            rgba="0.2 0.2 0.8 1"/>
    </body>

    <!-- ROD 1 (e.g. “defender”) at x = -0.15 -->
    <body name="rod_1" pos="-0.15 0 0">
      <joint name="rod_1_slide" type="slide" axis="0 1 0" range="-0.30 0.30"/>
      <body name="player_1" pos="0 0 0">
        <geom name="player_1_geom" type="capsule"
              fromto="0 0 0.01  0 0 0.09"
              size="0.015"
              density="500"
              contype="1" conaffinity="1"
              rgba="0 0 1 1"/>
      </body>
    </body>

    <!-- ROD 2 (e.g. “attacker”) at x = +0.15 -->
    <body name="rod_2" pos="0.15 0 0">
      <joint name="rod_2_slide" type="slide" axis="0 1 0" range="-0.30 0.30"/>
      <body name="player_2" pos="0 0 0">
        <geom name="player_2_geom" type="capsule"
              fromto="0 0 0.01  0 0 0.09"
              size="0.015"
              density="500"
              contype="1" conaffinity="1"
              rgba="0 0 1 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="rod_1_motor" joint="rod_1_slide" gear="1"/>
    <motor name="rod_2_motor" joint="rod_2_slide" gear="1"/>
  </actuator>
</mujoco>
